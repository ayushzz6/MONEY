# Copy to .env and fill in. Never commit .env.

# Angel One SmartAPI (market data in PAPER; data + orders in LIVE)
ANGEL_API_KEY=your-smartapi-key
ANGEL_CLIENT_ID=your-client-code-id/user-id
ANGEL_PASSWORD=your-pin
ANGEL_TOTP_SECRET=your-totp-secret

# PAPER (default) or LIVE. Overrides "mode" in configs/trading.json.
TRADING_MODE=PAPER

# Optional: Gemini as an advisory veto (llm_veto.enabled in configs/trading.json)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Telegram notifications (notify.telegram in configs/trading.json)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dashboard port (default 8050)
MONEYV2_PORT=8050

# Not used by the engine yet (historical data store)
NEON_DATABASE_URL=
